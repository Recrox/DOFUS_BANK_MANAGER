<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.19.1</Version>
    <Product>Dofus Bank Manager</Product>
    <!-- En Debug (dotnet run), pas d'élévation forcée : le bouton « Relancer en administrateur » suffit -->
    <ApplicationManifest Condition="'$(Configuration)' == 'Release'">app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <!-- Police Plus Jakarta Sans (SIL Open Font License, voir Fonts/OFL.txt) -->
    <Resource Include="Fonts\*.ttf;Fonts\OFL.txt" />
    <!-- XP des monstres (grade 1) -->
    <EmbeddedResource Include="Data\monstres-xp.json" LogicalName="DofusBankManager.Data.monstres-xp.json" />
    <!-- Interface HTML/CSS : servie depuis l'exe sous https://app.local/ -->
    <EmbeddedResource Include="Web\*" LogicalName="web/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>
