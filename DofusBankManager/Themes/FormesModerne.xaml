<!-- Formes du style Moderne : grands arrondis, police Segoe UI Variable, ombre douce sous l'en-tête -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <CornerRadius x:Key="RadiusXl">22</CornerRadius>
    <CornerRadius x:Key="RadiusLg">18</CornerRadius>
    <CornerRadius x:Key="RadiusMd">14</CornerRadius>
    <CornerRadius x:Key="RadiusSm">10</CornerRadius>
    <CornerRadius x:Key="RadiusXs">8</CornerRadius>
    <!-- Segoe UI Variable (Windows 11), sinon Segoe UI -->
    <FontFamily x:Key="AppFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.35"/>
</ResourceDictionary>
