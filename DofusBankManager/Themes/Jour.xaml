<!-- Thème Jour : parchemin clair -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FormesClassique.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="Bg" Color="#EADCC2"/>
    <LinearGradientBrush x:Key="HeaderBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FBF4E6" Offset="0"/>
        <GradientStop Color="#F1E4CB" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Surface" Color="#F8F0E0"/>
    <SolidColorBrush x:Key="Surface2" Color="#EFE1C6"/>
    <SolidColorBrush x:Key="Border" Color="#CDB287"/>
    <SolidColorBrush x:Key="Text" Color="#3A2513"/>
    <SolidColorBrush x:Key="TextMuted" Color="#7D6446"/>
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F39A35" Offset="0"/>
        <GradientStop Color="#D96A12" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentSolid" Color="#B85A0C"/>
    <SolidColorBrush x:Key="AccentBorder" Color="#C46A1A"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBg" Color="#FFFCF5"/>
    <SolidColorBrush x:Key="RowBg" Color="#FFFCF6"/>
    <SolidColorBrush x:Key="RowAlt" Color="#F6EDDC"/>
    <SolidColorBrush x:Key="HoverBg" Color="#F1DFC0"/>
    <SolidColorBrush x:Key="Selection" Color="#F2CC98"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#C9AE84"/>
    <SolidColorBrush x:Key="Ok" Color="#2E7D32"/>
    <SolidColorBrush x:Key="Missing" Color="#C0392B"/>
    <SolidColorBrush x:Key="Warning" Color="#8A6D3B"/>
    <!-- Onglets non sélectionnés -->
    <SolidColorBrush x:Key="TabBg" Color="#EFE1C6"/>
    <SolidColorBrush x:Key="TabBorder" Color="#CDB287"/>
</ResourceDictionary>
