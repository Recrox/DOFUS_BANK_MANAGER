<!-- Thème Nuit : sombre, accents orange atténués -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg" Color="#121010"/>
    <LinearGradientBrush x:Key="HeaderBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#221D19" Offset="0"/>
        <GradientStop Color="#1A1613" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Surface" Color="#1C1815"/>
    <SolidColorBrush x:Key="Surface2" Color="#27211C"/>
    <SolidColorBrush x:Key="Border" Color="#3A302A"/>
    <SolidColorBrush x:Key="Text" Color="#ECE2D5"/>
    <SolidColorBrush x:Key="TextMuted" Color="#9D8E7E"/>
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#DD8429" Offset="0"/>
        <GradientStop Color="#B85A10" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentSolid" Color="#E8954A"/>
    <SolidColorBrush x:Key="AccentBorder" Color="#E59A50"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBg" Color="#0E0C0B"/>
    <SolidColorBrush x:Key="RowBg" Color="#191512"/>
    <SolidColorBrush x:Key="RowAlt" Color="#1F1A16"/>
    <SolidColorBrush x:Key="HoverBg" Color="#2E2620"/>
    <SolidColorBrush x:Key="Selection" Color="#4A3018"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#4A3F36"/>
    <SolidColorBrush x:Key="Ok" Color="#7FCC70"/>
    <SolidColorBrush x:Key="Missing" Color="#FF7466"/>
    <SolidColorBrush x:Key="Warning" Color="#D9B670"/>
</ResourceDictionary>
