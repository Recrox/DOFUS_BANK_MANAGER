<!-- Style Moderne, thème Nuit : « Néon », verre fumé sur fond d'encre, dégradé violet → cyan -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FormesModerne.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!-- Fond : halos violet et cyan sur un noir bleuté -->
    <DrawingBrush x:Key="Bg" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0D0B1E" Offset="0"/>
                            <GradientStop Color="#07070F" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.12,0.05" GradientOrigin="0.12,0.05" RadiusX="0.65" RadiusY="0.75">
                            <GradientStop Color="#5B3BD6" Offset="0"/>
                            <GradientStop Color="#005B3BD6" Offset="1"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.95,0.95" GradientOrigin="0.95,0.95" RadiusX="0.6" RadiusY="0.7">
                            <GradientStop Color="#990E7490" Offset="0"/>
                            <GradientStop Color="#000E7490" Offset="1"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="HeaderBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D92A1E5C" Offset="0"/>
        <GradientStop Color="#D9141432" Offset="0.55"/>
        <GradientStop Color="#D90B3A4C" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Surface" Color="#D9121228"/>
    <SolidColorBrush x:Key="Surface2" Color="#F01B1B3A"/>
    <SolidColorBrush x:Key="Border" Color="#2EA5A0FF"/>
    <SolidColorBrush x:Key="Text" Color="#F1F0FF"/>
    <SolidColorBrush x:Key="TextMuted" Color="#9C9AC6"/>
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B5CF6" Offset="0"/>
        <GradientStop Color="#6366F1" Offset="0.5"/>
        <GradientStop Color="#06B6D4" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentSolid" Color="#A99BFF"/>
    <SolidColorBrush x:Key="AccentBorder" Color="#8B7CFF"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBg" Color="#E60A0A18"/>
    <SolidColorBrush x:Key="RowBg" Color="#00000000"/>
    <SolidColorBrush x:Key="RowAlt" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="HoverBg" Color="#268B7CFF"/>
    <SolidColorBrush x:Key="Selection" Color="#596366F1"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#668B7CFF"/>
    <SolidColorBrush x:Key="Ok" Color="#4ADE80"/>
    <SolidColorBrush x:Key="Missing" Color="#FB7185"/>
    <SolidColorBrush x:Key="Warning" Color="#FBBF24"/>
    <SolidColorBrush x:Key="TabBg" Color="#00000000"/>
    <SolidColorBrush x:Key="TabBorder" Color="#00000000"/>
    <DropShadowEffect x:Key="AccentGlow" Color="#7C5CFF" BlurRadius="22" ShadowDepth="0" Opacity="0.75"/>
</ResourceDictionary>
