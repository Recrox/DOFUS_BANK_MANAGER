<!-- Style Moderne, thème Jour : « Nacre », verre blanc sur un fond pastel, dégradé indigo → rose -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FormesModerne.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!-- Fond : halos lavande et pêche sur un blanc bleuté -->
    <DrawingBrush x:Key="Bg" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F3F4FF" Offset="0"/>
                            <GradientStop Color="#FBF5FA" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.1,0.0" GradientOrigin="0.1,0.0" RadiusX="0.7" RadiusY="0.8">
                            <GradientStop Color="#A5B4FC" Offset="0"/>
                            <GradientStop Color="#00A5B4FC" Offset="1"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.95,1" GradientOrigin="0.95,1" RadiusX="0.65" RadiusY="0.75">
                            <GradientStop Color="#B3FBCFE8" Offset="0"/>
                            <GradientStop Color="#00FBCFE8" Offset="1"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="HeaderBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6FFFFFF" Offset="0"/>
        <GradientStop Color="#D9EEF0FF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Surface" Color="#D9FFFFFF"/>
    <SolidColorBrush x:Key="Surface2" Color="#F2F4F3FF"/>
    <SolidColorBrush x:Key="Border" Color="#296366F1"/>
    <SolidColorBrush x:Key="Text" Color="#1E1B4B"/>
    <SolidColorBrush x:Key="TextMuted" Color="#6B6894"/>
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0"/>
        <GradientStop Color="#8B5CF6" Offset="0.5"/>
        <GradientStop Color="#EC4899" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentSolid" Color="#5B4BDB"/>
    <SolidColorBrush x:Key="AccentBorder" Color="#818CF8"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBg" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="RowBg" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="RowAlt" Color="#0D6366F1"/>
    <SolidColorBrush x:Key="HoverBg" Color="#1F6366F1"/>
    <SolidColorBrush x:Key="Selection" Color="#408B5CF6"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#80A5B4FC"/>
    <SolidColorBrush x:Key="Ok" Color="#16A34A"/>
    <SolidColorBrush x:Key="Missing" Color="#E11D48"/>
    <SolidColorBrush x:Key="Warning" Color="#B45309"/>
    <SolidColorBrush x:Key="TabBg" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="TabBorder" Color="#00FFFFFF"/>
    <DropShadowEffect x:Key="AccentGlow" Color="#8B5CF6" BlurRadius="20" ShadowDepth="2" Opacity="0.45"/>
</ResourceDictionary>
