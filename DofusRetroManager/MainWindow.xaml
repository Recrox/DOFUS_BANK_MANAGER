<!--
  Fenêtre principale : elle ne contient que la page HTML (WebView2). Les anciens contrôles WPF sont remplacés par des objets
  sans affichage (MainWindow.Controls.cs, WebControls.cs) que la page lit (MainWindow.WebUi.cs).
-->
<Window x:Class="DofusRetroManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dofus Retro Manager" Icon="app.ico" Height="800" Width="1300" MinWidth="960" MinHeight="540"
        Background="#0B0A18" WindowStartupLocation="CenterScreen">
    <ContentControl x:Name="WebHost"/>
</Window>
