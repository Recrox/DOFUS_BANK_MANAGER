<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>DofusBankManager-Setup</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- Dossier de l'application publiée, rempli par build-installer.ps1 -->
    <PayloadDir>$(MSBuildThisFileDirectory)payload</PayloadDir>
    <DefineConstants>PayloadDir=$(PayloadDir)</DefineConstants>
    <!-- Avertissements de validation MSI sans impact pour ce paquet -->
    <SuppressIces>ICE69;ICE91</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Firewall.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
